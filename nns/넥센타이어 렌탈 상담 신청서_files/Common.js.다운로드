//사업자 등록번호 체크
function fnBinNo(num) { 
    var reg = /([0-9]{3})-?([0-9]{2})-?([0-9]{5})/; 
    if (!reg.test(num)) return false; 
    num = RegExp.$1 + RegExp.$2 + RegExp.$3; 
    var cVal = 0; 
    for (var i=0; i<8; i++) { 
        var cKeyNum = parseInt(((_tmp = i % 3) == 0) ? 1 : ( _tmp == 1 ) ? 3 : 7); 
        cVal += (parseFloat(num.substring(i,i+1)) * cKeyNum) % 10; 
    } 
    var li_temp = parseFloat(num.substring(i,i+1)) * 5 + '0'; 
    cVal += parseFloat(li_temp.substring(0,1)) + parseFloat(li_temp.substring(1,2)); 
    return (parseInt(num.substring(9,10)) == 10-(cVal % 10)%10); 
}

//Element Tag Find Contorl
function fnFindControlsById(tagName, type, name)
{ 
    var controls = new Array();
    var tags = document.getElementsByTagName( tagName );
    var count = 0;
    for(var i = 0; i < tags.length ; i++) 
    { 
        if(tags[i].id.indexOf(name) >= 0 )
        { 
            if( type == null || type == "")
            {   
                controls[count] = tags[i];
                count++;
            }
            else if( type == tags[i].type )
            {
                controls[count] = tags[i];
                count++;
            }
        } 
    } 
    return controls; 
}

//체크박스 올체크/언체크
var rtnCheckBox = true;
function fnCheckBoxAllSelect(tagName)
{
    var controls = fnFindControlsById("input", "checkbox", tagName);
    if(rtnCheckBox){
        for(var i=0;i<controls.length;i++){
	        controls[i].checked = true;
	        rtnCheckBox = false;
	    }
	}else{
	    for(var i=0;i<controls.length;i++){
	        controls[i].checked = false;
	        rtnCheckBox = true;
	    }
	}
}

//Comma
function fnCommaSplit(srcNumber) 
{ 
    var txtNumber = '' + srcNumber; 

    var rxSplit = new RegExp('([0-9])([0-9][0-9][0-9][,.])'); 
    var arrNumber = txtNumber.split('.'); 
    arrNumber[0] += '.'; 
    do { 
        arrNumber[0] = arrNumber[0].replace(rxSplit, '$1,$2'); 
    } 
    while (rxSplit.test(arrNumber[0])); 
    if (arrNumber.length > 1) { 
        return arrNumber.join(''); 
    } 
    else { 
        return arrNumber[0].split('.')[0]; 
    } 
}

function popupResize(imgUrl){
    var popSource = "";
    var obj = document.createElement("img");
    obj.src=imgUrl.src;
    obj.id = 'newImg';

    var p = window.open("","","toolbar=no");
    document.body.appendChild(obj);

    setTimeout(function(){
     popSource = "<script> window.resizeTo( "+(obj.width+8)+", "+(obj.height+30)+" )<\/script>";
     obj.style.display = "none";
     popSource += "<body style='margin:0000'> <img src='"+imgUrl.src+"' onclick='self.close()'>";
     p.document.write(popSource);
    });
}

