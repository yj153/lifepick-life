/** 
* 입력값이 숫자로 되어있는지 체크 
*/ 
function isNum(input) { 
    var chars = "0123456789"; 
    return containsCharsOnly(input,chars);
}  

/** 
* 입력값에 특정 문자(chars)가 있는지 체크 
* 특정 문자를 허용하지 않으려 할 때 사용 
*/ 
function containsChars(input,chars) { 
    for (var inx = 0; inx < input.length; inx++) { 
       if (chars.indexOf(input.charAt(inx)) != -1) 
           return true; 
    } 
    return false; 
} 

/** 
* 입력값이 특정 문자(chars)만으로 되어있는지 체크 
* 특정 문자만 허용하려 할 때 사용
*/ 
function containsCharsOnly(input,chars) { 
    for (var inx = 0; inx < input.length; inx++) {
       if (chars.indexOf(input.charAt(inx)) == -1)
           return false; 
    } 
    return true;
}

/** 
* 입력값이 이메일 형식인지 체크 
*/ 
function isValidEmail(input) {
    var format = /^((\w|[\-\.])+)@((\w|[\-\.])+)\.([A-Za-z]+)$/; 
    return isValidFormat(input,format); 
}

/** 
* 입력값이 전화번호 형식(숫자-숫자-숫자)인지 체크 
*/ 
function isValidPhone(input) { 
    var format = /^(\d+)-(\d+)-(\d+)$/; 
    return isValidFormat(input,format); 
} 
function isValidPhoneNumber(input) { 
    var format = /^(\d+)$/; 
    return isValidFormat(input,format); 
}

/** 
* 입력값이 사용자가 정의한 포맷 형식인지 체크 
*/ 
function isValidFormat(input,format) { 
    if (input.search(format) != -1) { 
        return true; 
    } 
    return false; 
} 


function fnSsnCheck(ssn)
{
	if(ssn == "7002271786193") return 'NO'; 
	 var ssnStr = ssn.toString();
	 a = ssnStr.substring(0, 1);
	 b = ssnStr.substring(1, 2);
	 c = ssnStr.substring(2, 3);
	 d = ssnStr.substring(3, 4);
	 e = ssnStr.substring(4, 5);
	 f = ssnStr.substring(5, 6);
	 g = ssnStr.substring(6, 7);
	 h = ssnStr.substring(7, 8);
	 i = ssnStr.substring(8, 9);
	 j = ssnStr.substring(9, 10);
	 k = ssnStr.substring(10, 11);
	 l = ssnStr.substring(11, 12);
	 m = ssnStr.substring(12, 13);
	 month = ssnStr.substring(2,4);
	 day = ssnStr.substring(4,6);

	 if(month <= 0 || month > 12) return 'N';
	 if(day <= 0 || day > 31) return 'N';

	 if(g > 4 || g == 0) return 'N';

	 temp=a*2+b*3+c*4+d*5+e*6+f*7+g*8+h*9+i*2+j*3+k*4+l*5;
	 temp=temp%11;
	 temp=11-temp;
	 temp=temp%10;
	
	 if(temp == m)
		return 'Y';
	 else
		return 'N'; 
}

